# ===========================================
# ObraSync - Variáveis de Ambiente (Exemplo)
# ===========================================
# Copie este arquivo para .env.local e preencha os valores

# Supabase (obrigatório)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq AI (obrigatório para extração de memorial com IA)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ===========================================
# Variáveis opcionais
# ===========================================

# URL de redirecionamento para autenticação (quando implementar)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
